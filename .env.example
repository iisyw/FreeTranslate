# FreeTranslate 服务配置（复制此文件为 .env 并填入实际值）

# 服务器配置
PORT=8000
GIN_MODE=debug

# 自有 API 鉴权 Token（调用方需在请求头携带 Authorization: Bearer <token>）
API_TOKEN=change-me-before-production

# ============ 腾讯云 MPS 翻译 ============
# true=启用（需同时配置密钥），false=禁用
TENCENTCLOUD_ENABLED=true
TENCENTCLOUD_SECRET_ID=your-secret-id
TENCENTCLOUD_SECRET_KEY=your-secret-key

# ============ 火山引擎翻译 ============
# true=启用（需同时配置 AK/SK），false=禁用
VOLCANO_ENABLED=false
VOLCANO_ACCESS_KEY=your-access-key
VOLCANO_SECRET_KEY=your-secret-key

# ============ 阿里云机器翻译 ============
# true=启用（需同时配置 AK/SK），false=禁用
ALIBABA_ENABLED=false
ALIBABA_ACCESS_KEY=your-access-key
ALIBABA_SECRET_KEY=your-secret-key