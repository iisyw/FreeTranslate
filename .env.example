# FreeTranslate 服务配置

# 服务器配置
PORT=8000
GIN_MODE=debug

# 自有 API 鉴权 Token（调用方需在请求头携带 Authorization: Bearer <token>）
API_TOKEN=change-me-before-production

# 腾讯云 MPS 翻译配置
TENCENTCLOUD_SECRET_ID=your-secret-id
TENCENTCLOUD_SECRET_KEY=your-secret-key
# 腾讯云地域，TextTranslation 接口不需要 Region，可留空
TENCENTCLOUD_REGION=ap-guangzhou